{
    "manifest_version": 3,
    "name": "redactthing",
    "description": "Helping streamers redact their pii with a click",
    "version": "0.0.2",
    "icons": {
        "16": "logo/logo-16.png",
        "48": "logo/logo-48.png",
        "128": "logo/logo-128.png"
    },
    "options_page": "settings/settings.html",
    "action": {
        "default_title": "redactthing",
        "default_popup": "popup/popup.html"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "service-worker.js"
    },
    "content_scripts": [
        {
            "js": [
                "jquery.js",
                "foreground.js"
            ],
            "css": [
                "foreground.css"
            ],
            "matches": [
                "<all_urls>"
            ],
            "all_frames": true,
            "match_about_blank": true,
            "run_at": "document_idle"
        }
    ]
}
